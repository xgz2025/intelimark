      }
    },
    "Your iCloud data was deleted. Turn sync on to upload your library again." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 数据已被删除。打开同步即可重新上传资料库。"
          }
        }
      }
    },
    "Your library syncs through your private iCloud database; Laterwise has no server. The text of each save is end-to-end encrypted, and files are too with Advanced Data Protection. Without original files, titles, notes, text and previews still sync, using little iCloud space." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的资料库通过你的私有 iCloud 数据库同步，Laterwise 没有服务器。每项保存的文本均经过端到端加密，启用“高级数据保护”后文件也会加密。不同步原始文件时，标题、备注、文本和预览仍会同步，占用的 iCloud 空间很少。"
          }
        }
      }
    },
